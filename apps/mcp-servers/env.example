# =============================================================================
# MCP Servers Environment Configuration
# =============================================================================

# Database Configuration
# Choose one of the following approaches:

# Option 1: Complete database URL (recommended)
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Option 2: Individual database components (alternative)
# DB_HOST=localhost
# DB_NAME=rialto_db
# DB_USER=rialto_user
# DB_PASSWORD=your_password
# DB_PORT=5432

# =============================================================================
# OAuth Credentials for Token Refresh
# =============================================================================

# Microsoft Outlook/Graph API
OUTLOOK_CLIENT_ID=your_outlook_client_id
OUTLOOK_CLIENT_SECRET=your_outlook_client_secret
AZURE_TENANT_ID=your_azure_tenant_id

# Dropbox API
DROPBOX_CLIENT_ID=your_dropbox_client_id
DROPBOX_CLIENT_SECRET=your_dropbox_client_secret

# QuickBooks Online API
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret

# =============================================================================
# Token Refresh Service Configuration
# =============================================================================

# Base URL for the main Rialto API (for token refresh endpoints)
RIALTO_API_BASE_URL=http://localhost:8000

# Timeout for token refresh requests (in seconds)
TOKEN_REFRESH_TIMEOUT=30

# Optional: Service authentication key for inter-service communication
# MCP_SERVICE_AUTH_KEY=your_service_auth_key

# =============================================================================
# Application Configuration
# =============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8002
DEBUG=false
RELOAD=false

# Logging Configuration
LOG_LEVEL=INFO
DEBUG_MODE=false

# CORS Configuration
ALLOWED_ORIGINS=*
ALLOWED_METHODS=*
ALLOWED_HEADERS=*

# API Configuration
ENABLE_SWAGGER=true
ENABLE_METRICS=false
ENABLE_RATE_LIMITING=true
ENABLE_CORS=true

# =============================================================================
# Development/Testing Configuration
# =============================================================================

# Test user ID for development (optional)
TEST_USER_ID=your_test_user_uuid

# QuickBooks Realm ID for testing (optional)
QBO_REALM_ID=your_test_realm_id

# =============================================================================
# Security Notes
# =============================================================================

# 1. Never commit this file with real credentials to version control
# 2. Use environment-specific values for production deployments
# 3. Ensure OAuth credentials match those configured in the main Rialto API
# 4. Database credentials should match your PostgreSQL instance
# 5. The RIALTO_API_BASE_URL should point to your main API server
