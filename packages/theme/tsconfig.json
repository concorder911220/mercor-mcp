  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "declaration": true,
    "outDir": "./dist",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@rialto/design-tokens": ["../design-tokens/dist"]
    }
  },
  "include": ["src"]
}